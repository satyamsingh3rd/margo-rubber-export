{
  "name": "margo-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:claims": "node scripts/check-claims.mts",
    "typecheck": "tsc --noEmit",
    "check:links": "node scripts/check-links.mts",
    "check:links:strict": "node scripts/check-links.mts --strict",
    "gen:blur": "node scripts/gen-blur.mts",
    "check:enquiry": "node scripts/check-enquiry-map.mts",
    "check:schema": "sanity schema validate && node scripts/check-field-groups.mts && node scripts/check-labels.mts",
    "gen:sanity-types": "sanity schema extract --path sanity/schema.json && sanity typegen generate",
    "check:blocks": "node scripts/check-blocks-roundtrip.mts",
    "migrate:products": "node scripts/migrate-products.mts",
    "revalidate": "node scripts/revalidate.mts",
    "check:cms": "node scripts/check-cms-source.mts",
    "check:groups": "node scripts/check-field-groups.mts",
    "check:labels": "node scripts/check-labels.mts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@neondatabase/serverless": "^1.1.0",
    "@next/mdx": "^16.3.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.12.0",
    "@sanity/webhook": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "gray-matter": "^4.0.3",
    "next": "16.3.0",
    "next-sanity": "^13.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "sanity": "^6.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
